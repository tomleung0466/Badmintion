rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 共用 helper ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userAllowedWriteKeys() {
      return [
        'uid',
        'displayName',
        'email',
        'photoURL',
        'provider',
        'appName',
        'recentAttendance',
        'createdAt',
        'updatedAt',
        'paymeQR',
        'fpsQR',
        'hostPaymeQrUrl',
        'hostFpsQrUrl',
        'hostFpsId',
        'fpsId',
        'hostPaymentUpdatedAt',
        'hostSessionCount',
        'hostComplaintCount',
        'avatarUpdatedAt',
        'directoryOptIn'
      ];
    }

    function hostPublicProfileAllowedKeys() {
      return [
        'uid',
        'displayName',
        'photoURL',
        'updatedAt'
      ];
    }

    function activityHostFieldsUnchanged() {
      return request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.hostEmail == resource.data.hostEmail
        && request.resource.data.maxSlots == resource.data.maxSlots
        && request.resource.data.region == resource.data.region
        && request.resource.data.venue == resource.data.venue
        && request.resource.data.playDate == resource.data.playDate
        && request.resource.data.playTime == resource.data.playTime
        && request.resource.data.fee == resource.data.fee
        && request.resource.data.isPrivate == resource.data.isPrivate
        && request.resource.data.get('audience', resource.data.isPrivate ? 'private' : 'public')
          == resource.data.get('audience', resource.data.isPrivate ? 'private' : 'public')
        && request.resource.data.get('communityId', '') == resource.data.get('communityId', '')
        && request.resource.data.get('communityName', '') == resource.data.get('communityName', '')
        && request.resource.data.get('allowGuestSignupBy', 'none')
          == resource.data.get('allowGuestSignupBy', 'none')
        && request.resource.data.get('guestParticipants', {}) == resource.data.get('guestParticipants', {})
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('sessionStartsAt', null)
          == resource.data.get('sessionStartsAt', null)
        && request.resource.data.get('sessionEndsAt', null)
          == resource.data.get('sessionEndsAt', null);
    }

    function activityAudience(data) {
      return data.get('audience', data.isPrivate == true ? 'private' : 'public');
    }

    function isCommunityRestrictedActivity(data) {
      return activityAudience(data) == 'community'
        || (data.get('communityId', '') is string && data.get('communityId', '').size() > 0);
    }

    function canJoinActivityAudience(data) {
      return !isCommunityRestrictedActivity(data)
        || isCommunityMember(data.get('communityId', ''));
    }

    function isValidActivityAudienceOnCreate() {
      let data = request.resource.data;
      let aud = activityAudience(data);
      let communityId = data.get('communityId', '');
      return (aud == 'public' && data.isPrivate == false && communityId == '')
        || (aud == 'private' && data.isPrivate == true && communityId == '')
        || (aud == 'community'
          && data.isPrivate == false
          && communityId is string
          && communityId.size() > 0
          && isCommunityMember(communityId));
    }

    function activityNotEnded() {
      return resource.data.get('sessionEndsAt', timestamp.date(2099, 12, 31)) > request.time;
    }

    function safeList(data, field) {
      let raw = data.get(field, []);
      return raw == null ? [] : raw;
    }

    function safeListSize(data, field) {
      let raw = data.get(field, []);
      return raw == null ? 0 : raw.size();
    }

    function safeMapSize(data, field) {
      let raw = data.get(field, {});
      return raw == null ? 0 : raw.size();
    }

    function safeNumber(data, field) {
      let raw = data.get(field, 0);
      return raw == null ? 0 : raw;
    }

    function safeInt(data, field) {
      let raw = data.get(field, 0);
      return raw == null ? 0 : int(raw);
    }

    function effectiveMaxSlots(data) {
      let maxSlots = safeInt(data, 'maxSlots');
      return maxSlots >= 1 ? maxSlots : 99;
    }

    function participantListsEqual() {
      let oldUids = safeList(resource.data, 'participantUids');
      let newUids = safeList(request.resource.data, 'participantUids');
      return newUids.hasAll(oldUids) && newUids.size() == oldUids.size();
    }

    function pendingListsEqual() {
      let oldPending = safeList(resource.data, 'pendingParticipantUids');
      let newPending = safeList(request.resource.data, 'pendingParticipantUids');
      return newPending.hasAll(oldPending) && newPending.size() == oldPending.size();
    }

    function isHost() {
      return isSignedIn() && request.auth.uid == resource.data.hostUid;
    }

    function isApprovedParticipant() {
      return request.auth.uid in resource.data.get('participantUids', []);
    }

    function activityUpdateKeysOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function activityAllowedCreateKeys() {
      return [
        'hostUid',
        'hostEmail',
        'hostDisplayName',
        'hostPhotoURL',
        'isPrivate',
        'audience',
        'communityId',
        'communityName',
        'region',
        'venue',
        'playDate',
        'playTime',
        'startTime',
        'endTime',
        'sessionStartsAt',
        'sessionEndsAt',
        'duration',
        'courtCount',
        'displayTimeSlot',
        'fee',
        'shuttleInfo',
        'skillLevel',
        'contact',
        'maxSlots',
        'currentPlayers',
        'participants',
        'participantUids',
        'pendingParticipantUids',
        'waitlist',
        'guestParticipants',
        'allowGuestSignupBy',
        'createdAt',
        'updatedAt'
      ];
    }

    function activityListsEmptyOnCreate() {
      return request.resource.data.get('participantUids', []).size() == 0
        && request.resource.data.get('pendingParticipantUids', []).size() == 0
        && request.resource.data.get('waitlist', []).size() == 0
        && request.resource.data.get('participants', {}).size() == 0;
    }

    function activityHasPendingSlot(data) {
      return data.currentPlayers + safeListSize(data, 'pendingParticipantUids') < data.maxSlots;
    }

    function activityHostLockedForHostManage() {
      return request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.maxSlots == resource.data.maxSlots;
    }

    function participantUidsValidForApprove() {
      let oldUids = safeList(resource.data, 'participantUids');
      let newUids = safeList(request.resource.data, 'participantUids');
      let oldSize = oldUids.size();
      let newSize = newUids.size();
      return newUids.hasAll(oldUids) && (newSize == oldSize || newSize == oldSize + 1);
    }

    function pendingListShrunk() {
      let oldPending = safeList(resource.data, 'pendingParticipantUids');
      let newPending = safeList(request.resource.data, 'pendingParticipantUids');
      return oldPending.hasAll(newPending) && newPending.size() < oldPending.size();
    }

    function pendingListsShrinkByOne() {
      let oldPending = safeList(resource.data, 'pendingParticipantUids');
      let newPending = safeList(request.resource.data, 'pendingParticipantUids');
      return oldPending.hasAll(newPending) && newPending.size() == oldPending.size() - 1;
    }

    function participantsMapValidForApprove() {
      let oldSize = safeMapSize(resource.data, 'participants');
      let newSize = safeMapSize(request.resource.data, 'participants');
      return newSize == oldSize || newSize == oldSize + 1;
    }

    function participantsMapValidForReject() {
      let oldSize = safeMapSize(resource.data, 'participants');
      let newSize = safeMapSize(request.resource.data, 'participants');
      return newSize == oldSize || newSize == oldSize - 1;
    }

    function waitlistAndGuestsUnchanged() {
      let oldGuests = resource.data.get('guestParticipants', {});
      let newGuests = request.resource.data.get('guestParticipants', {});
      let oldWait = safeList(resource.data, 'waitlist');
      let newWait = safeList(request.resource.data, 'waitlist');
      let guestsOk = (oldGuests == null && newGuests == null)
        || (oldGuests == null && newGuests == {})
        || (oldGuests == {} && newGuests == null)
        || oldGuests == newGuests;
      return guestsOk && oldWait == newWait;
    }

    function isValidPendingParticipantProfile(uid) {
      let profile = request.resource.data.get('participants', {})[uid];
      return profile.uid == uid
        && profile.status == 'pending'
        && profile.displayName is string
        && profile.displayName.size() >= 1
        && profile.displayName.size() <= 64;
    }

    // 報名申請：加入 pendingParticipantUids，待場主批准
    function isValidPendingJoin() {
      let uid = request.auth.uid;
      let oldUids = resource.data.get('participantUids', []);
      let oldPending = resource.data.get('pendingParticipantUids', []);
      let newPending = request.resource.data.get('pendingParticipantUids', []);
      let oldWait = resource.data.get('waitlist', []);
      let newWait = request.resource.data.get('waitlist', []);
      let waitlistShrunkOk = newWait.size() == oldWait.size()
        || (uid in oldWait && newWait.size() == oldWait.size() - 1);

      return activityHostFieldsUnchanged()
        && activityNotEnded()
        && canJoinActivityAudience(resource.data)
        && activityHasPendingSlot(resource.data)
        && !(uid in oldUids)
        && !(uid in oldPending)
        && uid in newPending
        && newPending.size() == oldPending.size() + 1
        && request.resource.data.currentPlayers == resource.data.currentPlayers
        && participantListsEqual()
        && isValidPendingParticipantProfile(uid)
        && waitlistShrunkOk
        && activityUpdateKeysOnly(['pendingParticipantUids', 'participants', 'waitlist', 'waitlistProfiles', 'updatedAt']);
    }

    // 後補：滿額後把自己的 uid 加入 waitlist
    function isValidWaitlistJoin() {
      let uid = request.auth.uid;
      let oldWait = resource.data.get('waitlist', []);
      let newWait = request.resource.data.get('waitlist', []);

      return activityHostFieldsUnchanged()
        && activityNotEnded()
        && canJoinActivityAudience(resource.data)
        && resource.data.currentPlayers >= resource.data.maxSlots
        && !(uid in resource.data.get('participantUids', []))
        && !(uid in resource.data.get('pendingParticipantUids', []))
        && !(uid in oldWait)
        && uid in newWait
        && newWait.size() == oldWait.size() + 1
        && request.resource.data.currentPlayers == resource.data.currentPlayers
        && participantListsEqual()
        && activityUpdateKeysOnly(['waitlist', 'waitlistProfiles', 'updatedAt']);
    }
    function isValidCancelApproved() {
      let uid = request.auth.uid;
      let oldUids = resource.data.get('participantUids', []);
      let newUids = request.resource.data.get('participantUids', []);

      return activityHostFieldsUnchanged()
        && uid in oldUids
        && !(uid in newUids)
        && newUids.size() == oldUids.size() - 1
        && request.resource.data.currentPlayers == resource.data.currentPlayers - 1
        && request.resource.data.currentPlayers >= 0
        && pendingListsEqual()
        && waitlistAndGuestsUnchanged()
        && !(uid in request.resource.data.get('participants', {}))
        && activityUpdateKeysOnly(['participantUids', 'participants', 'currentPlayers', 'updatedAt']);
    }

    // 取消待批准申請
    function isValidCancelPending() {
      let uid = request.auth.uid;
      let oldPending = resource.data.get('pendingParticipantUids', []);
      let newPending = request.resource.data.get('pendingParticipantUids', []);

      return activityHostFieldsUnchanged()
        && uid in oldPending
        && !(uid in newPending)
        && newPending.size() == oldPending.size() - 1
        && request.resource.data.currentPlayers == resource.data.currentPlayers
        && participantListsEqual()
        && waitlistAndGuestsUnchanged()
        && !(uid in request.resource.data.get('participants', {}))
        && activityUpdateKeysOnly(['pendingParticipantUids', 'participants', 'updatedAt']);
    }

    function isValidHostApprove() {
      let oldPlayers = safeInt(resource.data, 'currentPlayers');
      let newPlayers = safeInt(request.resource.data, 'currentPlayers');
      let maxSlots = effectiveMaxSlots(resource.data);
      let playersIncreased = newPlayers == oldPlayers + 1 && newPlayers <= maxSlots;
      let playersUnchanged = newPlayers == oldPlayers;

      return isHost()
        && activityHostLockedForHostManage()
        && pendingListShrunk()
        && participantUidsValidForApprove()
        && participantsMapValidForApprove()
        && (playersIncreased || playersUnchanged)
        && activityUpdateKeysOnly(['participantUids', 'pendingParticipantUids', 'participants', 'currentPlayers', 'updatedAt']);
    }

    function isValidHostReject() {
      return isHost()
        && activityHostLockedForHostManage()
        && safeInt(request.resource.data, 'currentPlayers') == safeInt(resource.data, 'currentPlayers')
        && participantListsEqual()
        && pendingListShrunk()
        && participantsMapValidForReject()
        && activityUpdateKeysOnly(['pendingParticipantUids', 'participants', 'updatedAt']);
    }

    function allowsGuestSignup(data) {
      let mode = data.get('allowGuestSignupBy', 'none');
      return mode == 'host_only' || mode == 'host_and_participants';
    }

    function activityGuestHostFieldsUnchanged() {
      return request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.hostEmail == resource.data.hostEmail
        && request.resource.data.maxSlots == resource.data.maxSlots
        && request.resource.data.region == resource.data.region
        && request.resource.data.venue == resource.data.venue
        && request.resource.data.playDate == resource.data.playDate
        && request.resource.data.playTime == resource.data.playTime
        && request.resource.data.fee == resource.data.fee
        && request.resource.data.isPrivate == resource.data.isPrivate
        && request.resource.data.get('audience', resource.data.isPrivate ? 'private' : 'public')
          == resource.data.get('audience', resource.data.isPrivate ? 'private' : 'public')
        && request.resource.data.get('communityId', '') == resource.data.get('communityId', '')
        && request.resource.data.get('communityName', '') == resource.data.get('communityName', '')
        && request.resource.data.get('allowGuestSignupBy', 'none')
          == resource.data.get('allowGuestSignupBy', 'none')
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.sessionStartsAt == resource.data.sessionStartsAt
        && request.resource.data.sessionEndsAt == resource.data.sessionEndsAt;
    }

    function isValidGuestAddByHost() {
      let oldGuests = resource.data.get('guestParticipants', {});
      let newGuests = request.resource.data.get('guestParticipants', {});
      let guestDiff = newGuests.diff(oldGuests);

      return isHost()
        && activityNotEnded()
        && allowsGuestSignup(resource.data)
        && activityGuestHostFieldsUnchanged()
        && guestDiff.addedKeys().size() == 1
        && guestDiff.removedKeys().size() == 0
        && guestDiff.changedKeys().size() == 0
        && resource.data.currentPlayers < resource.data.maxSlots
        && request.resource.data.currentPlayers == resource.data.currentPlayers + 1
        && request.resource.data.currentPlayers <= request.resource.data.maxSlots
        && participantListsEqual()
        && pendingListsEqual()
        && request.resource.data.get('pendingParticipantUids', [])
          == resource.data.get('pendingParticipantUids', [])
        && request.resource.data.get('waitlist', []) == resource.data.get('waitlist', [])
        && activityUpdateKeysOnly(['guestParticipants', 'currentPlayers', 'updatedAt']);
    }

    function isValidGuestAddByParticipant() {
      let oldGuests = resource.data.get('guestParticipants', {});
      let newGuests = request.resource.data.get('guestParticipants', {});
      let guestDiff = newGuests.diff(oldGuests);

      return isApprovedParticipant()
        && !isHost()
        && activityNotEnded()
        && resource.data.get('allowGuestSignupBy', 'none') == 'host_and_participants'
        && activityGuestHostFieldsUnchanged()
        && guestDiff.addedKeys().size() == 1
        && guestDiff.removedKeys().size() == 0
        && guestDiff.changedKeys().size() == 0
        && resource.data.currentPlayers < resource.data.maxSlots
        && request.resource.data.currentPlayers == resource.data.currentPlayers + 1
        && request.resource.data.currentPlayers <= request.resource.data.maxSlots
        && participantListsEqual()
        && pendingListsEqual()
        && request.resource.data.get('pendingParticipantUids', [])
          == resource.data.get('pendingParticipantUids', [])
        && request.resource.data.get('waitlist', []) == resource.data.get('waitlist', [])
        && activityUpdateKeysOnly(['guestParticipants', 'currentPlayers', 'updatedAt']);
    }

    function isValidGuestAdd() {
      return isValidGuestAddByHost() || isValidGuestAddByParticipant();
    }

    function isValidGuestRemoveByHost() {
      let oldGuests = resource.data.get('guestParticipants', {});
      let newGuests = request.resource.data.get('guestParticipants', {});
      let guestDiff = newGuests.diff(oldGuests);

      return isHost()
        && activityGuestHostFieldsUnchanged()
        && guestDiff.removedKeys().size() == 1
        && guestDiff.addedKeys().size() == 0
        && guestDiff.changedKeys().size() == 0
        && request.resource.data.currentPlayers == resource.data.currentPlayers - 1
        && request.resource.data.currentPlayers >= 0
        && participantListsEqual()
        && pendingListsEqual()
        && request.resource.data.get('pendingParticipantUids', [])
          == resource.data.get('pendingParticipantUids', [])
        && request.resource.data.get('waitlist', []) == resource.data.get('waitlist', [])
        && activityUpdateKeysOnly(['guestParticipants', 'currentPlayers', 'updatedAt']);
    }

    function isValidGuestRemoveByParticipant() {
      let oldGuests = resource.data.get('guestParticipants', {});
      let newGuests = request.resource.data.get('guestParticipants', {});
      let guestDiff = newGuests.diff(oldGuests);

      return isApprovedParticipant()
        && !isHost()
        && activityGuestHostFieldsUnchanged()
        && guestDiff.removedKeys().size() == 1
        && guestDiff.addedKeys().size() == 0
        && guestDiff.changedKeys().size() == 0
        && request.resource.data.currentPlayers == resource.data.currentPlayers - 1
        && request.resource.data.currentPlayers >= 0
        && participantListsEqual()
        && pendingListsEqual()
        && request.resource.data.get('pendingParticipantUids', [])
          == resource.data.get('pendingParticipantUids', [])
        && request.resource.data.get('waitlist', []) == resource.data.get('waitlist', [])
        && activityUpdateKeysOnly(['guestParticipants', 'currentPlayers', 'updatedAt']);
    }

    function isValidGuestRemove() {
      return isValidGuestRemoveByHost() || isValidGuestRemoveByParticipant();
    }

    function isValidActivityCreate() {
      return request.resource.data.hostUid == request.auth.uid
        && request.resource.data.keys().hasOnly(activityAllowedCreateKeys())
        && activityListsEmptyOnCreate()
        && request.resource.data.maxSlots is number
        && request.resource.data.maxSlots >= 1
        && request.resource.data.maxSlots <= 50
        && request.resource.data.currentPlayers == 0
        && request.resource.data.playDate is string
        && request.resource.data.region is string
        && request.resource.data.venue is string
        && request.resource.data.keys().hasAll(['sessionStartsAt', 'sessionEndsAt'])
        && request.resource.data.sessionStartsAt is timestamp
        && request.resource.data.sessionStartsAt > request.time
        && request.resource.data.sessionEndsAt is timestamp
        && request.resource.data.sessionEndsAt > request.time
        && request.resource.data.sessionEndsAt > request.resource.data.sessionStartsAt
        && isValidActivityAudienceOnCreate()
        && request.resource.data.get('guestParticipants', {}).size() == 0
        && (
          request.resource.data.get('allowGuestSignupBy', 'none') == 'none'
          || request.resource.data.get('allowGuestSignupBy', 'none') == 'host_only'
          || request.resource.data.get('allowGuestSignupBy', 'none') == 'host_and_participants'
        );
    }

    function isCommunityMember(communityId) {
      return exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    function isCommunityOwner(communityId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid;
    }

    function communityAllowedKeys() {
      return ['name', 'description', 'ownerUid', 'createdAt', 'updatedAt'];
    }

    function isValidCommunityCreate() {
      let data = request.resource.data;
      return data.ownerUid == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.description is string
        && data.description.size() <= 200
        && data.keys().hasAll(['name', 'description', 'ownerUid', 'createdAt', 'updatedAt']);
    }

    function isValidCommunityOwnerUpdate() {
      return resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && (!('description' in request.resource.data)
          || (request.resource.data.description is string
            && request.resource.data.description.size() <= 200))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'updatedAt']);
    }

    function communityMemberAllowedKeys() {
      return ['uid', 'displayName', 'photoURL', 'role', 'joinedAt'];
    }

    function isValidCommunityMemberCreate(communityId, memberUid) {
      let data = request.resource.data;

      return memberUid == request.auth.uid
        && data.uid == request.auth.uid
        && data.role in ['owner', 'member']
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 64
        && data.keys().hasAll(['uid', 'displayName', 'role', 'joinedAt'])
        && (!('photoURL' in data) || data.photoURL is string)
        && (
          data.role == 'member'
          || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid
        );
    }

    function communityMembershipAllowedKeys() {
      return ['communityId', 'name', 'role', 'joinedAt'];
    }

    function hostPublicPaymentAllowedKeys() {
      return [
        'hostUid',
        'paymeQR',
        'fpsQR',
        'hostPaymeQrUrl',
        'hostFpsQrUrl',
        'hostFpsId',
        'fpsId',
        'updatedAt'
      ];
    }

    // 場主收款 QR / FPS：已登入球友可讀（報名付款頁顯示用）
    match /hostPublicPayment/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.hostUid == userId
        && request.resource.data.keys().hasOnly(hostPublicPaymentAllowedKeys());
      allow update: if isOwner(userId)
        && request.resource.data.hostUid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(hostPublicPaymentAllowedKeys());
      allow delete: if isOwner(userId);
    }

    // 場主公開資料：大廳場次卡片顯示名字與頭像
    match /hostPublicProfile/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(hostPublicProfileAllowedKeys());
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(hostPublicProfileAllowedKeys());
      allow delete: if isOwner(userId);
    }

    // ── users：個人資料 + 收款 QR (paymeQR / fpsQR) ─────────
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userAllowedWriteKeys());
      allow delete: if isOwner(userId);

      // 出席率（卡片 hover 顯示）
      match /attendance/{docId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // 社群成員索引（僅本人可讀寫自己的清單）
      match /communityMemberships/{communityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.communityId == communityId
          && request.resource.data.keys().hasAll(['communityId', 'name', 'role', 'joinedAt'])
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(userId));
        allow update: if false;
        allow delete: if isOwner(userId)
          || (isSignedIn()
            && isCommunityOwner(communityId)
            && userId != request.auth.uid);
      }

      // 社群邀請（搜尋邀請進社群）
      match /communityInvites/{communityId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn()
          && communityId == request.resource.data.communityId
          && get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid
          && userId != request.auth.uid
          && exists(/databases/$(database)/documents/userDirectory/$(userId))
          && !exists(/databases/$(database)/documents/communities/$(communityId)/members/$(userId))
          && request.resource.data.invitedByUid == request.auth.uid
          && request.resource.data.communityName is string
          && request.resource.data.invitedByName is string
          && request.resource.data.keys().hasAll(['communityId', 'communityName', 'invitedByUid', 'invitedByName', 'createdAt']);
        allow update: if false;
        allow delete: if isOwner(userId)
          || (isSignedIn()
            && resource.data.invitedByUid == request.auth.uid
            && get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid);
      }
    }

    function feedbackAllowedKeys() {
      return [
        'uid',
        'email',
        'displayName',
        'message',
        'appVersion',
        'appBuild',
        'page',
        'userAgent',
        'createdAt'
      ];
    }

    // ── feedback：用戶意見（僅建立；後台於 Firebase Console 查看） ──
    match /feedback/{feedbackId} {
      allow read: if false;
      allow update, delete: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1000
        && request.resource.data.keys().hasOnly(feedbackAllowedKeys());
    }

    // ── userDirectory：可被搜尋邀請的公開索引 ────────────────
    match /userDirectory/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 64
        && request.resource.data.displayNameLower is string
        && request.resource.data.displayNameLower.size() >= 1
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'displayNameLower', 'photoURL', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    // ── communities：社群（Phase 1）────────────────────────
    match /communities/{communityId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isValidCommunityCreate();
      allow update: if isSignedIn() && isValidCommunityOwnerUpdate();
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if isSignedIn() && (
          memberUid == request.auth.uid
          || isCommunityMember(communityId)
        );
        allow create: if isSignedIn()
          && isValidCommunityMemberCreate(communityId, memberUid);
        allow update: if false;
        allow delete: if isSignedIn()
          && resource.data.role != 'owner'
          && (
            memberUid == request.auth.uid
            || (memberUid != request.auth.uid && isCommunityOwner(communityId))
          );
      }
    }

    // ── activities：發佈 / 報名 / 後補 / 取消 ────────────────
    match /activities/{activityId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidActivityCreate();
      allow update: if isSignedIn() && (
        isValidPendingJoin()
        || isValidWaitlistJoin()
        || isValidCancelApproved()
        || isValidCancelPending()
        || isValidHostApprove()
        || isValidHostReject()
        || isValidGuestAdd()
        || isValidGuestRemove()
      );
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
