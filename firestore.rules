rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 共用 helper ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userAllowedWriteKeys() {
      return [
        'uid',
        'displayName',
        'email',
        'photoURL',
        'provider',
        'appName',
        'recentAttendance',
        'createdAt',
        'updatedAt',
        'paymeQR',
        'fpsQR',
        'hostPaymeQrUrl',
        'hostFpsQrUrl',
        'hostFpsId',
        'fpsId',
        'hostPaymentUpdatedAt'
      ];
    }

    function activityHostFieldsUnchanged() {
      return request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.hostEmail == resource.data.hostEmail
        && request.resource.data.maxSlots == resource.data.maxSlots
        && request.resource.data.region == resource.data.region
        && request.resource.data.venue == resource.data.venue
        && request.resource.data.playDate == resource.data.playDate
        && request.resource.data.playTime == resource.data.playTime
        && request.resource.data.fee == resource.data.fee
        && request.resource.data.isPrivate == resource.data.isPrivate
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function participantListsEqual() {
      let oldUids = resource.data.get('participantUids', []);
      let newUids = request.resource.data.get('participantUids', []);
      return newUids.hasAll(oldUids) && newUids.size() == oldUids.size();
    }

    function pendingListsEqual() {
      let oldPending = resource.data.get('pendingParticipantUids', []);
      let newPending = request.resource.data.get('pendingParticipantUids', []);
      return newPending.hasAll(oldPending) && newPending.size() == oldPending.size();
    }

    function isHost() {
      return isSignedIn() && request.auth.uid == resource.data.hostUid;
    }

    // 報名申請：加入 pendingParticipantUids，待場主批准
    function isValidPendingJoin() {
      let uid = request.auth.uid;
      let oldUids = resource.data.get('participantUids', []);
      let oldPending = resource.data.get('pendingParticipantUids', []);
      let newPending = request.resource.data.get('pendingParticipantUids', []);
      let oldWait = resource.data.get('waitlist', []);
      let newWait = request.resource.data.get('waitlist', []);
      let waitlistShrunkOk = newWait.size() == oldWait.size()
        || (uid in oldWait && newWait.size() == oldWait.size() - 1);

      return activityHostFieldsUnchanged()
        && !(uid in oldUids)
        && !(uid in oldPending)
        && uid in newPending
        && newPending.size() == oldPending.size() + 1
        && request.resource.data.currentPlayers == resource.data.currentPlayers
        && participantListsEqual()
        && uid in request.resource.data.get('participants', {})
        && waitlistShrunkOk;
    }

    // 後補：滿額後把自己的 uid 加入 waitlist
    function isValidWaitlistJoin() {
      let uid = request.auth.uid;
      let oldWait = resource.data.get('waitlist', []);
      let newWait = request.resource.data.get('waitlist', []);

      return activityHostFieldsUnchanged()
        && resource.data.currentPlayers >= resource.data.maxSlots
        && !(uid in resource.data.get('participantUids', []))
        && !(uid in resource.data.get('pendingParticipantUids', []))
        && !(uid in oldWait)
        && uid in newWait
        && newWait.size() == oldWait.size() + 1
        && request.resource.data.currentPlayers == resource.data.currentPlayers
        && participantListsEqual();
    }

    // 取消已批准預約
    function isValidCancelApproved() {
      let uid = request.auth.uid;
      let oldUids = resource.data.get('participantUids', []);
      let newUids = request.resource.data.get('participantUids', []);

      return activityHostFieldsUnchanged()
        && uid in oldUids
        && !(uid in newUids)
        && newUids.size() == oldUids.size() - 1
        && request.resource.data.currentPlayers == resource.data.currentPlayers - 1
        && request.resource.data.currentPlayers >= 0
        && pendingListsEqual()
        && !(uid in request.resource.data.get('participants', {}));
    }

    // 取消待批准申請
    function isValidCancelPending() {
      let uid = request.auth.uid;
      let oldPending = resource.data.get('pendingParticipantUids', []);
      let newPending = request.resource.data.get('pendingParticipantUids', []);

      return activityHostFieldsUnchanged()
        && uid in oldPending
        && !(uid in newPending)
        && newPending.size() == oldPending.size() - 1
        && request.resource.data.currentPlayers == resource.data.currentPlayers
        && participantListsEqual()
        && !(uid in request.resource.data.get('participants', {}));
    }

    function isValidHostApprove() {
      let oldPending = resource.data.get('pendingParticipantUids', []);
      let newPending = request.resource.data.get('pendingParticipantUids', []);
      let oldUids = resource.data.get('participantUids', []);
      let newUids = request.resource.data.get('participantUids', []);

      return isHost()
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.maxSlots == resource.data.maxSlots
        && request.resource.data.currentPlayers == resource.data.currentPlayers + 1
        && request.resource.data.currentPlayers <= request.resource.data.maxSlots
        && newUids.size() == oldUids.size() + 1
        && newPending.size() == oldPending.size() - 1;
    }

    function isValidHostReject() {
      let oldPending = resource.data.get('pendingParticipantUids', []);
      let newPending = request.resource.data.get('pendingParticipantUids', []);
      let oldUids = resource.data.get('participantUids', []);
      let newUids = request.resource.data.get('participantUids', []);

      return isHost()
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.maxSlots == resource.data.maxSlots
        && request.resource.data.currentPlayers == resource.data.currentPlayers
        && newUids.size() == oldUids.size()
        && newPending.size() == oldPending.size() - 1;
    }

    function isValidActivityCreate() {
      return request.resource.data.hostUid == request.auth.uid
        && request.resource.data.maxSlots is int
        && request.resource.data.maxSlots >= 1
        && request.resource.data.maxSlots <= 50
        && request.resource.data.currentPlayers is int
        && request.resource.data.currentPlayers >= 0
        && request.resource.data.currentPlayers <= request.resource.data.maxSlots
        && request.resource.data.playDate is string
        && request.resource.data.region is string
        && request.resource.data.venue is string;
    }

    // ── users：個人資料 + 收款 QR (paymeQR / fpsQR) ─────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userAllowedWriteKeys());
      allow delete: if false;

      // 出席率（卡片 hover 顯示）
      match /attendance/{docId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }
    }

    // ── activities：發佈 / 報名 / 後補 / 取消 ────────────────
    match /activities/{activityId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidActivityCreate();
      allow update: if isSignedIn() && (
        isValidPendingJoin()
        || isValidWaitlistJoin()
        || isValidCancelApproved()
        || isValidCancelPending()
        || isValidHostApprove()
        || isValidHostReject()
      );
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
